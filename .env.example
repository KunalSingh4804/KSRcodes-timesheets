# Native local PostgreSQL. Replace both local password placeholders consistently.
LOCAL_DATABASE_PASSWORD=REPLACE_LOCAL_PASSWORD
DATABASE_URL=postgresql://multiverse:REPLACE_LOCAL_PASSWORD@localhost:5432/multiverse
PORT=4000
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
AUTH_MODE=development
# Optional embedded development database instead of DATABASE_URL:
# DEV_DATABASE=pglite
# Required when AUTH_MODE=entra. Never use development auth in production.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:5173/auth/callback
# Set only behind the intended trusted ingress proxy:
# TRUST_PROXY=1
