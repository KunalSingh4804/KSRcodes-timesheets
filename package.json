{
  "name": "multiverse-timesheets",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node --import tsx scripts/dev.ts",
    "dev:api": "node --import tsx server/src/index.ts",
    "dev:web": "vite --config web/vite.config.ts --host 0.0.0.0",
    "build": "tsc --noEmit && vite build --config web/vite.config.ts && tsc -p server/tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint server web/src scripts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --import tsx prisma/seed.ts",
    "start": "node build/server/src/index.js",
    "test:api": "vitest run --config vitest.api.config.ts",
    "provision": "node --import tsx scripts/provision.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "5.1.4",
    "eslint": "10.13.0",
    "prettier": "3.6.2",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@azure/msal-node": "7.1.1",
    "@electric-sql/pglite": "0.5.11",
    "@hookform/resolvers": "5.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@tanstack/react-query": "5.90.21",
    "cookie-parser": "1.4.7",
    "dotenv": "17.3.1",
    "express": "5.2.1",
    "express-rate-limit": "8.7.1",
    "helmet": "8.1.0",
    "jose": "6.1.3",
    "lucide-react": "0.563.0",
    "pg": "8.19.0",
    "pglite-prisma-adapter": "0.7.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "7.71.1",
    "react-router-dom": "7.18.4",
    "zod": "4.6.7"
  }
}
