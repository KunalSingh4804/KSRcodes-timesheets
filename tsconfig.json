{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "vite/client"],
    "noEmit": true
  },
  "include": [
    "server/**/*.ts",
    "prisma/**/*.ts",
    "scripts/**/*.ts",
    "web/src/**/*.ts",
    "web/src/**/*.tsx",
    "prisma.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "vitest.api.config.ts"
  ]
}
